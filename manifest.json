{
  "manifest_version": 3,
  "name": "Word Lookup Translator",
  "version": "1.1.0",
  "description": "Hover an English word for a Bing-style card with IPA and Chinese definitions (dict.cn)",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://dict.cn/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/content_script.js"],
      "css": ["ui/highlight.css", "ui/tooltip.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Word Lookup — click to toggle 取词"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
